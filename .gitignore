/target
*.db
*.db-wal
*.db-shm
.DS_Store

# local preview fixtures — Firebase serves static files BEFORE rewrites,
# so committing these would shadow the live /data/** worker API
web/data/
web/.claude/
node_modules/
.firebase/
__pycache__/
*.py[cod]

# Local Claude settings and audit notes stay private. The GitNexus-generated
# code-navigation skills are deliberately portable so Codex and Claude get the
# same repository map after a fresh clone.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/generated/
!.claude/skills/generated/**
!.claude/skills/gitnexus/
!.claude/skills/gitnexus/**
HANDOFF-AUDIT.md

# Remotion promo-video project — rendered locally, not tracked
video/

# generated aggregate for the private traffic dashboard
web/ops/traffic/traffic.json

# Remote-access hardening scripts. They describe how admin access to the box
# is locked down, which is intel an attacker would want and nobody else needs.
# Kept on the machine and on the VPS, never published.
scripts/ops/harden-*.ps1
scripts/ops/RUNBOOK.md

# Bot runtime state: the message id the price bot keeps updating, which
# changelog entries have gone out, who is verified. All of it is local to
# whichever machine runs the bot and meaningless in git, and committing it
# means one machine's state overwrites another's on the next pull. Credentials
# are never in these files; those live in env only.
.kascov-*.json

# Screenshots pasted into the working tree while getting help. Personal, large,
# and never part of the project.
clipboard-*.png

# Playwright browser-test output
playwright-report/
test-results/

# generated at deploy time by the holder bot, never committed
web/vote-tally.json
web/passport-claims.json
web/passport-anchor.json
.gitnexus
