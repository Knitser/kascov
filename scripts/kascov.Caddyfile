# kascov.io single-origin serving on the VPS (replaces Firebase Hosting +
# Cloud Run). Static SPA from disk, worker reverse-proxied under the SAME
# origin — which fixes SSE buffering, share-page crawling, and CORS for good.
#
# Run in WSL on the VPS (worker listens on 127.0.0.1:8080 there). On Windows,
# port-forward 80/443 -> WSL, OR run Caddy on Windows and proxy to the WSL IP.
#
# NOTE (verified 2026-07-29): this file is the WSL variant and is NOT what
# production runs — see kascov.windows.Caddyfile. Its old `tls internal` +
# Cloudflare note was stale: nothing proxies kascov.io today. Every hostname
# resolves straight to the box and Caddy terminates public TLS itself via
# ACME, so there is no edge WAF, no rate limiting, and no origin cloaking in
# front of the origin. Do not restrict ingress to Cloudflare ranges while
# that is true — it would black-hole the whole site.

kascov.io, www.kascov.io {
	encode zstd gzip

	# --- API + dynamic worker routes (mirror firebase.json rewrites) ---
	# SSE must NOT be buffered — flush_interval -1 streams it.
	@stream path /data/*/stream
	handle @stream {
		reverse_proxy 127.0.0.1:8080 {
			flush_interval -1
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
		}
	}

	@worker {
		path /data/* /share/* /og/* /badge/* /img/* /sitemap.xml /feed.xml /health /healthz
	}
	handle @worker {
		reverse_proxy 127.0.0.1:8080 {
			header_up Host {host}
			header_up X-Forwarded-For {remote_host}
		}
	}

	# --- static SPA (the web/ build) ---
	handle {
		root * /srv/kascov/web
		# real files (style.css, app.js, og.png) are served directly; the clean-URL
		# form {path}.html stays for any future standalone page (Firebase used to do
		# this). Every other path — /guide, /explore, /testnet-10/c/<id> — falls back
		# to the SPA shell, which turns the pathname into its hash route.
		try_files {path} {path}.html {path}/ /index.html
		file_server
	}

	# WSL-variant only. Production (kascov.windows.Caddyfile) has no `tls`
	# directive and lets Caddy provision a real ACME cert, because nothing
	# terminates TLS in front of the origin.
	tls internal

	log {
		output file /var/log/caddy/kascov.log
		format console
	}
}
