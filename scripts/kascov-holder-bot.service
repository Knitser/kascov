[Unit]
Description=kascov Discord holder verification (interactions endpoint)
After=network-online.target kascov-worker.service
Wants=network-online.target

[Service]
Type=simple
User=kascov
WorkingDirectory=/home/kascov/kascov
# Its own credential file, not the webhook one. A bot token can act as the bot
# everywhere it is installed, so the price and changelog bots never load it.
EnvironmentFile=/home/kascov/.discord-bot-env
Environment=KASCOV_BOT_STATE=/home/kascov/kascov-holder-bot.json
Environment=KASCOV_BOT_PORT=8099
# the public vote tally must land inside the served tree or /vote shows nothing
Environment=KASCOV_VOTE_TALLY=/mnt/c/kascov/web/vote-tally.json
# same rule for the passport claims file (/passport-claims.json on the site)
Environment=KASCOV_PASSPORT_OUT=/mnt/c/kascov/web/passport-claims.json
ExecStart=/usr/bin/node /home/kascov/kascov/scripts/discord-holder-bot.mjs
# Discord retries an interaction that times out, so a crash must come back
# fast or a member sees "the application did not respond".
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/kascov /mnt/c/kascov/web

[Install]
WantedBy=multi-user.target
